% nix, package management

# Update flake inputs
nix flake update

# Rebuild home-manager configuration
home-manager switch --flake .

# Search for a package
nix search nixpkgs <package>

# Run a package without installing
nix run nixpkgs#<package>

# Enter development shell
nix develop

# Show flake outputs
nix flake show

# Garbage collect old generations
nix-collect-garbage -d

# List generations
home-manager generations

# Rollback to previous generation
home-manager switch --rollback

# Check flake syntax
nix flake check

# Update specific input
nix flake lock --update-input <input>

# Open shell with temporary packages
nix shell nixpkgs#<packages>

# Build local package
nix build

# Show why package depends on another
nix why-depends <package1> <package2>

# Optimize nix store (remove duplicates)
nix store optimise

# Show package metadata
nix eval nixpkgs#<package>.meta --json | jq

$ package: echo "Enter package name"
$ input: nix flake metadata --json | jq -r '.locks.nodes.root.inputs | keys[]'
$ packages: echo "ripgrep fd jq" "python3 nodejs" | tr ' ' '\n'
$ package1: echo ".#default"
$ package2: echo "nixpkgs#glibc nixpkgs#gcc" | tr ' ' '\n'

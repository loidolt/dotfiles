% git, version control

# Undo last commit but keep changes
git reset --soft HEAD~1

# Amend last commit message
git commit --amend -m "<message>"

# Interactive rebase last n commits
git rebase -i HEAD~<n>

# Stash with message
git stash push -m "<message>"

# Apply specific stash
git stash apply stash@{<index>}

# Delete merged branches
git branch --merged | grep -v "\*" | xargs -n 1 git branch -d

# Checkout remote branch
git fetch origin <branch>:<branch> && git checkout <branch>

# Reset file to last commit
git checkout HEAD -- <file>

# Show changes in stash
git stash show -p stash@{<index>}

$ n: echo "1 2 3 4 5" | tr ' ' '\n'
$ index: git stash list | cut -d: -f1 | sed 's/stash@{//;s/}//'
$ branch: git branch -r | sed 's/origin\///' | grep -v HEAD
$ file: git status --short | awk '{print $2}'
$ message: echo "Enter commit message"

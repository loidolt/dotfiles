% docker, containers, compose

# Remove all stopped containers
docker container prune -f

# Remove all unused images
docker image prune -a -f

# Remove all volumes
docker volume prune -f

# Stop all running containers
docker stop $(docker ps -q)

# Remove container and its volumes
docker rm -v <container>

# View container logs with tail
docker logs -f --tail <lines> <container>

# Execute command in running container
docker exec -it <container> <command>

# Copy file from container to host
docker cp <container>:<source_path> <dest_path>

# Copy file from host to container
docker cp <source_path> <container>:<dest_path>

# Inspect container IP address
docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <container>

# Build with no cache
docker build --no-cache -t <tag> .

# Start compose services in detached mode
docker-compose up -d

# Stop compose services and remove volumes
docker-compose down -v

# View logs for specific compose service
docker-compose logs -f <service>

# Restart specific compose service
docker-compose restart <service>

# Execute command in running compose service
docker-compose exec <service> <compose_command>

# List compose services with status
docker-compose ps

# Pull latest images for compose services
docker-compose pull

# Build and start compose services with no cache
docker-compose build --no-cache && docker-compose up -d

$ container: docker ps -a --format '{{.Names}}'
$ lines: echo "50 100 200 500" | tr ' ' '\n'
$ command: echo "/bin/bash /bin/sh sh bash" | tr ' ' '\n'
$ source_path: echo "/path/to/file"
$ dest_path: echo "/path/to/destination"
$ tag: echo "image:tag"
$ service: docker-compose ps --services
$ compose_command: echo "/bin/bash /bin/sh bash sh" | tr ' ' '\n'

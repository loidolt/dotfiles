{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "mcp": {
    "sequentialthinking": {
      "type": "local",
      "enabled": true,
      "command": ["docker", "run", "--rm", "-i", "mcp/sequentialthinking"]
    },
    "memory": {
      "type": "local",
      "enabled": false,
      "command": ["docker", "run", "-i", "-v", "claude-memory:/app/dist", "--rm", "mcp/memory"]
    },
    "puppeteer": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "puppeteer-mcp-server"]
    },
    "github": {
      "type": "remote",
      "enabled": false,
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}

# SSH Configuration
# Add your hosts here

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

# Example host:
# Host myserver
#     HostName example.com
#     User myuser
#     IdentityFile ~/.ssh/id_rsa
#     Port 22

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github

# SSH Configuration (Shared across all machines)
# Machine-specific hosts are in ~/.ssh/config.local

# Include host-specific configuration (if it exists)
Include ~/.ssh/config.local

# DevPod Start my-home.devpod
Host my-home.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user node my-home
  User node
# DevPod End my-home.devpod
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    # UseKeychain is macOS-only, add it to config.local on macOS hosts


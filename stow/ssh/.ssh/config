# SSH Configuration (Shared across all machines)
# Machine-specific hosts are in ~/.ssh/config.local

# Include host-specific configuration (if it exists)
Include config.local

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes

# Example common host:
# Host shared-server
#     HostName example.com
#     User myuser
#     IdentityFile ~/.ssh/id_rsa

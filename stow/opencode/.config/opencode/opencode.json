{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "mcp": {
    "sequentialthinking": {
      "type": "local",
      "enabled": true,
      "command": ["docker", "run", "--rm", "-i", "mcp/sequentialthinking"]
    },
    "memory": {
      "type": "local",
      "enabled": false,
      "command": ["docker", "run", "-i", "-v", "claude-memory:/app/dist", "--rm", "mcp/memory"]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--browser", "chromium"]
    },
    "github": {
      "type": "remote",
      "enabled": false,
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "looker": {
      "type": "local",
      "enabled": true,
      "command": ["toolbox", "--stdio", "--prebuilt", "looker"]
    },
    "excel": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "excel-mcp-server", "stdio"]
    }
  }
}

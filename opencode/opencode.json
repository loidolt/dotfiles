{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "mcp": {
    "sequentialthinking": {
      "type": "local",
      "enabled": true,
      "command": ["docker", "run", "--rm", "-i", "mcp/sequentialthinking"]
    },
    "memory": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "run",
        "-i",
        "-v",
        "claude-memory:/app/dist",
        "--rm",
        "mcp/memory"
      ]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "--isolated", "@playwright/mcp@latest"]
    },
    "github": {
      "type": "remote",
      "enabled": false,
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "cloudflare": {
      "type": "remote",
      "enabled": true,
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "mui": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@mui/mcp@latest"]
    }
  }
}

# OpenCode MCP Server API Keys
# Copy these to your shell profile (~/.zshrc or ~/.bashrc) and replace with your actual keys

# Context7 MCP Server
# Get your key from: https://context7.com
export CONTEXT7_API_KEY="your-context7-api-key-here"

# Ref Tools MCP Server
# Get your key from: https://ref.tools
export REF_API_KEY="your-ref-api-key-here"

# Airtable MCP Server
# Get your key from: https://airtable.com/create/tokens
export AIRTABLE_API_KEY="your-airtable-api-key-here"

# Mapbox MCP Server
# Get your token from: https://account.mapbox.com/access-tokens/
export MAPBOX_ACCESS_TOKEN="your-mapbox-access-token-here"

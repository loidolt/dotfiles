# Local Secrets Configuration
#
# Copy this file to secrets.nix and fill in your values.
# secrets.nix is gitignored and will not be committed.
#
# Usage:
#   cp secrets.nix.example secrets.nix
#   # Edit secrets.nix with your actual values

{
  # RustDesk configuration
  # Reference: https://rustdesk.com/docs/en/self-host/client-configuration/
  #
  # To get the configString:
  #   1. Open RustDesk on any machine
  #   2. Go to Settings → Network → ID/Relay Server
  #   3. Enter your server address and key manually
  #   4. Click "Export Server Config" 
  #   5. Paste the copied string below
  #
  # The configString is a base64-encoded string that contains all server settings.
  # It looks something like: "host=xxx,key=yyy,..." but encoded.
  rustdesk = {
    # REQUIRED: Exported config string from a configured RustDesk client
    # Get this from: Settings → Network → Export Server Config
    configString = "your-exported-config-string-here";

    # OPTIONAL: Permanent password for unattended access
    # This is set via `rustdesk --password` on first login
    password = "your-permanent-password";
  };

  # Add other secrets here as needed
}

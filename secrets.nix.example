# Local Secrets Configuration
#
# Copy this file to secrets.nix and fill in your values.
# secrets.nix is gitignored and will not be committed.
#
# Usage:
#   cp secrets.nix.example secrets.nix
#   # Edit secrets.nix with your actual values

{
  # RustDesk configuration
  rustdesk = {
    server = "your-rustdesk-server.example.com";
    key = "your-public-key-here";
  };

  # Add other secrets here as needed
}

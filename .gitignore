# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# Environment and local config
.direnv/
.envrc

# Backups
*.backup
*.backup.*
*.bak

# Temporary files
*.tmp
*.log

# Node modules (in configs that have them)
node_modules/
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local secrets and sensitive configs
secrets/
*.key
*.pem
*.crt
!*.example

# Host-specific SSH configurations (private)
hosts/*/ssh-config

# Claude/AI tool configs (local only - ignore root, allow stow package)
/.claude/
!stow/claude/.claude/

# Personal notes/scratchpad (if you create these)
notes/
scratchpad/
TODO.md
NOTES.md

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
vendor/

# Terraform/Infrastructure
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Kubernetes
kubeconfig
*.kubeconfig

# Environment files (except examples)
.env
.env.*
.env.local
!.env.example

# Root-level config files (to avoid accidentally committing local configs)
# Stow package versions are tracked in stow/ directory
/.gitconfig
/.zshrc
/.tmux.conf
/.fzf.zsh
/.ssh
logs/
result

/tmp
.playwright-mcp

# AI Tools - sensitive and runtime files

# Codex - secrets and credentials
stow/codex/.codex/auth.json

# Codex - per-machine runtime state (codex rewrites these constantly)
stow/codex/.codex/config.toml
stow/codex/.codex/version.json
stow/codex/.codex/.personality_migration
stow/codex/.codex/.codex-global-state.json
stow/codex/.codex/AGENTS.md
stow/codex/.codex/installation_id
stow/codex/.codex/session_index.jsonl
stow/codex/.codex/models_cache.json
stow/codex/.codex/history.jsonl

# Codex - runtime data directories
stow/codex/.codex/sessions/
stow/codex/.codex/archived_sessions/
stow/codex/.codex/log/
stow/codex/.codex/tmp/
stow/codex/.codex/cache/
stow/codex/.codex/sqlite/
stow/codex/.codex/plugins/
stow/codex/.codex/shell_snapshots/
stow/codex/.codex/ambient-suggestions/
stow/codex/.codex/computer-use/
stow/codex/.codex/vendor_imports/

# Codex - sqlite log/state files (e.g. logs_2.sqlite, state_5.sqlite-wal)
stow/codex/.codex/logs_*.sqlite*
stow/codex/.codex/state_*.sqlite*

# Codex - bundled system skills and runtime-installed skills
# (auto-updated by codex installer, not user-managed)
stow/codex/.codex/skills/.system/
stow/codex/.codex/skills/pdf/

# Gemini
stow/gemini/.gemini/google_accounts.json
stow/gemini/.gemini/oauth_creds.json
stow/gemini/.gemini/installation_id
stow/gemini/.gemini/state.json
stow/gemini/.gemini/tmp/

# Navi
stow/navi/.config/navi/navi.log
# Hardware configurations - tracked per-host for reproducibility
# Each host's hardware-configuration.nix is generated with:
#   sudo nixos-generate-config --show-hardware-config > hardware-configuration.nix
# Then committed to the repo
!hosts/*/hardware-configuration.nix

# Neovim plugin lock file (generated at runtime)
configs/neovim/lazy-lock.json

# Home Manager backups
*.backup
*.backup.*
*.bak

# Temporary files
*.tmp
*.log

# Node modules (in configs that have them)
node_modules/
bun.lock
package-lock.json
yarn.lock

# Claude/AI tool configs (local only)
.claude/


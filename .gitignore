# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# Environment and local config
.direnv/
.envrc

# Backups
*.backup
*.backup.*
*.bak

# Temporary files
*.tmp
*.log

# Node modules (in configs that have them)
node_modules/
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local secrets and sensitive configs
secrets/
*.key
*.pem
*.crt
!*.example

# Host-specific SSH configurations (private)
hosts/*/ssh-config

# Claude/AI tool configs (local only - ignore root, allow stow package)
/.claude/
!stow/claude/.claude/

# Personal notes/scratchpad (if you create these)
notes/
scratchpad/
TODO.md
NOTES.md

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
vendor/

# Terraform/Infrastructure
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Kubernetes
kubeconfig
*.kubeconfig

# Environment files (except examples)
.env
.env.*
.env.local
!.env.example

# Root-level config files (to avoid accidentally committing local configs)
# Stow package versions are tracked in stow/ directory
/.gitconfig
/.zshrc
/.tmux.conf
/.fzf.zsh
/.ssh
logs/
result

/tmp
.playwright-mcp

# AI Tools - sensitive and runtime files

# Codex - whitelist: codex keeps all runtime state (sqlite, sessions, auth,
# locks, approval rules, installed skills) in ~/.codex, which is stowed here.
# Only the hand-maintained files below are tracked.
stow/codex/.codex/*
!stow/codex/.codex/config.yaml
!stow/codex/.codex/instructions.md

# Gemini
stow/gemini/.gemini/google_accounts.json
stow/gemini/.gemini/oauth_creds.json
stow/gemini/.gemini/installation_id
stow/gemini/.gemini/state.json
stow/gemini/.gemini/tmp/
stow/gemini/.gemini/projects.json
stow/gemini/.gemini/skills/

# Claude - claude.ai synced skills cache (managed by Claude Code)
stow/claude/.claude/skills/synced/

# Vendor skills installed per machine (same set lands in claude/codex/gemini).
# Reinstall instead of tracking; see README "AI tool skills".
stow/claude/.claude/skills/agents-sdk/
stow/claude/.claude/skills/cloudflare/
stow/claude/.claude/skills/cloudflare-*/
stow/claude/.claude/skills/durable-objects/
stow/claude/.claude/skills/sandbox-*/
stow/claude/.claude/skills/turnstile-spin/
stow/claude/.claude/skills/web-perf/
stow/claude/.claude/skills/workers-best-practices/
stow/claude/.claude/skills/wrangler/

# Navi
stow/navi/.config/navi/navi.log
# systemd user units - enablement links are per machine
stow/systemd/.config/systemd/user/*.wants/
